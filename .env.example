# ==============================================================================
# DEMİRTÜRK PORTFÖY - KURUMSAL POSTA (MAILCOW / IMAP / SMTP) YAPILANDIRMASI
# ==============================================================================
# Bu dosya bir yapılandırma şablonudur. Gerçek parolaları ve gizli API anahtarlarını
# kesinlikle repoya eklemeyiniz. Canlı sunucuda .env adıyla kopyalayınız.

# 1. MAILCOW YÖNETİM API'Sİ (Sunucuda Hesap, Kota ve Takma Ad Yönetimi)
# Mailcow Admin Panel -> Configuration -> Access -> API alanından üretilen Read/Write anahtarı
MAILCOW_API_HOST=https://mail.demirturkinsaat.com
MAILCOW_API_KEY=your_mailcow_api_key_here
MAILCOW_DOMAIN=demirturkinsaat.com

# 2. IMAP SUNUCU AYARLARI (Gelen E-Postaları Okuma ve Klasör Senkronizasyonu)
IMAP_HOST=mail.demirturkinsaat.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_TLS_REJECT_UNAUTHORIZED=true

# 3. SMTP SUNUCU AYARLARI (Giden E-Posta İletimi)
SMTP_HOST=mail.demirturkinsaat.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true

# 4. GÜVENLİK VE ŞİFRELEME (Sunucuda Posta Kimlik Bilgilerini Saklama)
# Veritabanında saklanan posta şifrelerini çözmek için kullanılan 32-baytlık anahtar
MAIL_ENCRYPTION_SECRET=your_32_byte_aes_secret_key_here

# 5. E-POSTA BOYUT VE KOTA LİMİTLERİ
MAX_ATTACHMENT_SIZE_MB=25
DEFAULT_MAILBOX_QUOTA_MB=10240

# 6. SUPABASE VERİTABANI VE GERÇEK ZAMANLI SENKRONİZASYON
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY


# Edge Function secrets: bunları VITE_ önekiyle tanımlamayın.
# SUPABASE_URL ve SUPABASE_SERVICE_ROLE_KEY Edge ortamı tarafından sağlanır.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_GRAPH_VERSION=
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

META_ALLOWED_ORIGINS=https://YOUR_CRM_DOMAIN
# Var olan cloud sync davranışı korunur; güvenli Auth/RLS geçişinden önce açmayın.
VITE_ENABLE_SUPABASE_SYNC=false

# DEMO: Meta geri bildirimi yalnızca elle gönderilir. Cron/worker ve auto_sync açılmaz.
